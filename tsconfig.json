{
  "compilerOptions": {
    "module": "esnext",
    "resolveJsonModule": true,
    "declaration": true,
    "noImplicitAny": false,
    "removeComments": true,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es6",
    "sourceMap": true,
    "lib": [
      "dom",
      "dom.iterable",
      "es6"
    ],
    "skipLibCheck": true,
    "types": ["node"] 
  },
  "exclude": [
    "node_modules", 
    "**/*.spec.ts", 
    "**/__tests__/**",
    "**/*.stories.*",
  ]
}